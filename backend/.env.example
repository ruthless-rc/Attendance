# Face Recognition Attendance System - Environment Variables
PROJECT_NAME="Face Recognition Attendance System"
API_V1_STR=/api
SECRET_KEY="super-secret-key-face-attendance-2026-production-secure"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./attendance.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/face_attendance"

# Recognition & Anti-Spoofing Defaults
DEFAULT_RECOGNITION_THRESHOLD=0.45
DEFAULT_DUPLICATE_INTERVAL_SECONDS=86400
DEFAULT_LIVENESS_MODE="passive"
DEFAULT_LATE_CUTOFF_TIME="09:30"
DEFAULT_PRIVACY_CONSENT_TEXT="By registering, you consent to the collection and processing of your facial biometric data solely for attendance verification in accordance with organizational policies."

# Initial Seed Admin
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="admin123"
ADMIN_DEFAULT_EMAIL="admin@organization.local"
